---
layout: base.njk
title: Devlog - Justin Joshi
---

	<!-- Devlog Header -->
	<section id="header" class="devlog-header">
		<div class="inner">
			<span class="icon solid major fa-pencil-alt"></span>
			<h1><strong>Devlog</strong></h1>
			<p>Thoughts, lessons, and progress on my engineering journey.</p>
			<ul class="actions special">
				<li><a href="/" class="button">Back to Portfolio</a></li>
			</ul>
		</div>
	</section>

	<!-- Post Listing -->
	<section class="main style1">
		<div class="container">
			{% set posts = collections.devlogPosts | reverse %}
			{% if posts | length > 0 %}
			<div class="devlog-listing">
				{% for post in posts %}
				<article class="devlog-listing-item">
					<header>
						<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
						<h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
					</header>
					<p>{{ post.data.excerpt }}</p>
					{% if post.data.tags | length > 0 %}
					<div class="devlog-tags">
						{% for tag in post.data.tags %}
							{% if tag !== "devlogPosts" %}
							<span class="devlog-tag">{{ tag }}</span>
							{% endif %}
						{% endfor %}
					</div>
					{% endif %}
					<a href="{{ post.url }}" class="button small">Read More</a>
				</article>
				{% endfor %}
			</div>
			{% else %}
			<p class="align-center">No posts yet. Check back soon!</p>
			{% endif %}
		</div>
	</section>
