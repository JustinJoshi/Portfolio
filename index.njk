	</section>

	<!-- Devlog Preview -->
	{% set posts = collections.devlogPosts | reverse %}
	{% if posts | length > 0 %}
	<section id="devlog-preview" class="main style1 special">
		<div class="container">
			<header class="major">
				<h2>Latest from the Devlog</h2>
			</header>
			<div class="devlog-cards">
				{% for post in posts %}
					{% if loop.index0 < 3 %}
					<article class="devlog-card">
						<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
						<h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
						<p>{{ post.data.excerpt }}</p>
						<a href="{{ post.url }}" class="button small">Read More</a>
					</article>
					{% endif %}
				{% endfor %}
			</div>
			<ul class="actions special" style="margin-top: 2em;">
				<li><a href="/devlog/" class="button">View All Posts</a></li>
			</ul>
		</div>
	</section>
	{% endif %}

	<!-- CTA -->
	<section id="cta" class="main style2 special">
		<div class="container">
			<header>
				<h2>Ready to start your next project?</h2>
			</header>
			<p>Lets build something special.</p>
		</div>
	</section>
